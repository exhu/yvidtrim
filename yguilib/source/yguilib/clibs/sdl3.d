/// bindings to yguilib-clib-sdl C library
module yguilib.clibs.sdl3;

enum yguilib_sdl3_EventType : int {
  none = 0,
  quit,
  windowClose,
  windowResized,
  windowExposed,
  windowDisplayScaleChanged,
  mouseMotion,
  mouseButtonDown,
  mouseButtonUp,
  keyDown,
  keyUp,
  textEditing,
  textInput,
  wake,
  unknown,
}

struct yguilib_sdl3_Rect {
  int x;
  int y;
  int w;
  int h;
}

struct yguilib_sdl3_Event {
  yguilib_sdl3_EventType type;
  uint windowId;
  int width;
  int height;
  float x;
  float y;
  float scale;
  uint key;
  uint scancode;
  ushort mod;
  ubyte repeat;
  ubyte padding;
  const(char)* text;
  int start;
  int length;
}

static assert(yguilib_sdl3_Event.sizeof == 56);

struct yguilib_sdl3_Window;
struct yguilib_sdl3_GLContext;

enum yguilib_sdl3_LogPriority : int {
  verbose = 1,
  debug_ = 2,
  info = 3,
  warn = 4,
  error = 5,
  critical = 6,
}

