  none = 0x0000u,
  lshift = 0x0001u,
  rshift = 0x0002u,
  level5 = 0x0004u,
  lctrl = 0x0040u,
  rctrl = 0x0080u,
  lalt = 0x0100u,
  ralt = 0x0200u,
  lgui = 0x0400u,
  rgui = 0x0800u,
  num = 0x1000u,
  caps = 0x2000u,
  mode = 0x4000u,
  scroll = 0x8000u,
  ctrl = lctrl | rctrl,
  shift = lshift | rshift,
  alt = lalt | ralt,
  gui = lgui | rgui,
}
